{
  "name": "@kahme247/pi-swarm",
  "version": "1.2.2",
  "description": "Native pi multi-agent swarms recovered from Antigravity CLI's bundled swarm contracts and board.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "swarm", "multi-agent"],
  "engines": { "node": ">=22" },
